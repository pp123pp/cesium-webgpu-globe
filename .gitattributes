# Auto detect text files and perform LF normalization
* text=auto
package.json text eol=lf

# Keep these recorded capture-harness hashes stable on Windows checkout.
coordination/ci/m2.6.1-b5-b-temporal.mjs text eol=lf
coordination/ci/m2.6.1-b5-c-performance.mjs text eol=lf
coordination/ci/m2.6.1-b5-c-lifecycle.mjs text eol=lf
coordination/ci/m2.6.1-b5-c-audit.mjs text eol=lf

# M2.8 report digests refer to the original LF JSON capture bytes.
coordination/evidence/M2.8/**/*.json text eol=lf

# Generated GPU payloads are binary, including ramps with no NUL bytes.
*.r8 binary
*.rgba8 binary
